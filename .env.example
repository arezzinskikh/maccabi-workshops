# Database - application user (used by Strapi)
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_NAME=maccabi_workshops

# Postgres admin password (used only by the postgres container itself)
POSTGRES_ADMIN_PASSWORD=postgres

# Strapi security secrets (generate random values for production)
JWT_SECRET=your-jwt-secret-32-chars-minimum
ADMIN_JWT_SECRET=your-admin-jwt-secret-32-chars
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=your-api-token-salt
TRANSFER_TOKEN_SALT=your-transfer-token-salt

# Frontend
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Create an API token in Strapi admin panel and paste it here
STRAPI_API_TOKEN=

# Node environment
NODE_ENV=development
