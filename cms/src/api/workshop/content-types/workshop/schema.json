{
  "kind": "collectionType",
  "collectionName": "strapi_workshops",
  "info": {
    "singularName": "workshop",
    "pluralName": "workshops",
    "displayName": "Workshop",
    "description": "Individual workshop entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 300
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false,
      "maxLength": 300
    },
    "description": {
      "type": "text",
      "required": true
    },
    "registration_link": {
      "type": "string",
      "maxLength": 500
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "hours": {
      "type": "decimal",
      "required": false
    },
    "age_range": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "cost": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "long_description": {
      "type": "text",
      "required": false
    },
    "prerequisites": {
      "type": "text",
      "required": false
    },
    "what_youll_learn": {
      "type": "text",
      "required": false
    },
    "target_audience": {
      "type": "text",
      "required": false
    },
    "sessions": {
      "type": "component",
      "repeatable": true,
      "component": "workshop.session"
    },
    "external_id": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "source_slug": {
      "type": "string",
      "required": false,
      "maxLength": 100,
      "default": "cms"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "workshops"
    },
    "cycle_start_date": {
      "type": "date",
      "required": false
    },
    "cycle_end_date": {
      "type": "date",
      "required": false
    },
    "registration_deadline": {
      "type": "date",
      "required": false
    },
    "max_participants": {
      "type": "integer",
      "required": false
    },
    "num_free_places": {
      "type": "integer",
      "required": false
    },
    "num_participants": {
      "type": "integer",
      "required": false
    },
    "contact_name": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "contact_email": {
      "type": "email",
      "required": false
    },
    "contact_phone": {
      "type": "string",
      "required": false,
      "maxLength": 50
    },
    "district_name": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "branch_name": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "language": {
      "type": "string",
      "required": false,
      "maxLength": 100
    },
    "min_age": {
      "type": "integer",
      "required": false
    },
    "max_age": {
      "type": "integer",
      "required": false
    },
    "meeting_address": {
      "type": "string",
      "required": false,
      "maxLength": 500
    },
    "meeting_place_name": {
      "type": "string",
      "required": false,
      "maxLength": 300
    }
  }
}
