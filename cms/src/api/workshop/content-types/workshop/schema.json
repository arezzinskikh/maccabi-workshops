{
  "kind": "collectionType",
  "collectionName": "workshops",
  "info": {
    "singularName": "workshop",
    "pluralName": "workshops",
    "displayName": "Workshop",
    "description": "Individual workshop entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 300
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false,
      "maxLength": 300
    },
    "description": {
      "type": "text",
      "required": true
    },
    "registration_link": {
      "type": "string",
      "maxLength": 500
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "hours": {
      "type": "decimal",
      "required": false
    },
    "age_range": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "cost": {
      "type": "string",
      "required": false,
      "maxLength": 200
    },
    "long_description": {
      "type": "text",
      "required": false
    },
    "prerequisites": {
      "type": "text",
      "required": false
    },
    "what_youll_learn": {
      "type": "text",
      "required": false
    },
    "target_audience": {
      "type": "text",
      "required": false
    },
    "sessions": {
      "type": "component",
      "repeatable": true,
      "component": "workshop.session"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "workshops"
    }
  }
}
