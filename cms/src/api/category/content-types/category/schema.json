{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "Workshop categories"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "icon_url": {
      "type": "string",
      "maxLength": 500
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "workshops": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::workshop.workshop",
      "mappedBy": "category"
    }
  }
}
